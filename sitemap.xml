---
# Every page, in every language, with its translations. Add a page's slug
# here when you add a page.
slugs: ["/", "/about", "/uses", "/contact"]
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for slug in page.slugs %}
{%- for l in site.data.languages %}
  <url>
    <loc>{{ site.origin }}{{ l.prefix }}{{ slug }}</loc>
{%- for a in site.data.languages %}
    <xhtml:link rel="alternate" hreflang="{{ a.code }}" href="{{ site.origin }}{{ a.prefix }}{{ slug }}"/>
{%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ site.data.languages.first.prefix }}{{ slug }}"/>
  </url>
{%- endfor %}
{%- endfor %}
</urlset>
